# NITER CAMPUS DINING SYSTEM - ENVIRONMENT CONFIGURATION

# SETUP INSTRUCTIONS:
# 1. Copy this file and rename it to exactly: `.env`
# 2. Fill in the empty string values below with your own credentials.
# 3. NEVER commit your real `.env` file to GitHub!

# 1. DATABASE CONNECTION (Required)
# Create a free serverless Postgres database at neon.tech
# Paste your connection string here. Make sure it ends with ?sslmode=require
DATABASE_URL="postgresql://[user]:[password]@[host]/[database]?sslmode=require"

# 2. NEXTAUTH & SECURITY (Required)
# This encrypts all user sessions. Generate a random 32+ character string.
# (Tip: you can generate one by running `openssl rand -base64 32` in terminal)
NEXTAUTH_SECRET="your_generated_secret_string"

# Base URL of the deployed application. 
# For local development, leave these as http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. BKASH SMS FORWARDER INTEGRATION (Required for automated deposits)
# This secures your webhook from unauthorized access. 
# Example: If your Android SMS app sends data to /api/bkash-webhook?secret=mySecureKey99
# Then you must set this variable to "mySecureKey99".
BKASH_WEBHOOK_SECRET=""

# 4. GOOGLE SHEETS / EMAIL WEBHOOKS (Optional for local testing)
# A custom secret key you create to protect your Google Sheets data export endpoints.
MASTER_SHEET_SECRET=""

# To set up these URLs:
# 1. Create a new Google Apps Script.
# 2. Deploy it as a "Web App" accessible to "Anyone".
# 3. Paste the generated Execution URLs here.
GOOGLE_SCRIPT_EMAIL_URL="https://script.google.com/macros/s/.../exec"
GOOGLE_SCRIPT_AUTO="https://script.google.com/macros/s/.../exec"
GOOGLE_SCRIPT_SCAN_LOG_URL="https://script.google.com/macros/s/.../exec"