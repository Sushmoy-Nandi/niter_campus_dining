generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  DEPOSIT
  MEAL_DEDUCTION
  ADJUSTMENT
  REFUND
}

enum UserRole {
  STUDENT
  ADMIN
  STAFF
}

enum RefundMethod {
  BKASH
  NAGAD
  ROCKET
  CASH
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(STUDENT)
  accounts      Account[]
  sessions      Session[]
  otpCode       String?
  otpExpiresAt  DateTime?

  student  Student?
  admin    Admin?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Student {
  id         String   @id @default(cuid())
  studentId  String   @unique
  diningId   String?  @unique
  name       String
  email      String   @unique
  department String
  session    String
  isActive   Boolean  @default(true)
  userId     String   @unique
  whatsapp   String?
  faceDescriptor String? @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet?
  transactions      Transaction[]
  mealSchedules     MealSchedule[]
  dailyCharges      DailyCharge[]
  auditLogs         AuditLog[]
  depositApprovals  DepositApproval[]
  refundRequests    RefundRequest[]
  mealFeedbacks     MealFeedback[]
  pollVotes         PollVote[]
  claimedBkash      BkashLedger[]  @relation("ClaimedBkash")
  mealCheckIns      MealCheckIn[]
}

model Wallet {
  id        String  @id @default(cuid())
  studentId String  @unique
  balance   Float   @default(0)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String          @id @default(cuid())
  studentId   String
  type        TransactionType
  amount      Float
  description String?
  createdAt   DateTime        @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type, createdAt])
  @@index([createdAt])
}

model MealRate {
  id             String   @id @default(cuid())
  lunchPrice     Float
  dinnerPrice    Float
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())
}

model MealSchedule {
  id            String   @id @default(cuid())
  studentId     String
  date          DateTime
  lunch         Boolean  @default(false)
  dinner        Boolean  @default(false)
  adminOverride Boolean  @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
}

model DailyCharge {
  id             String   @id @default(cuid())
  studentId      String
  date           DateTime
  lunchCharge    Float    @default(0)
  dinnerCharge   Float    @default(0)
  totalCharge    Float    @default(0)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  userId       String   @unique

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  depositApprovals DepositApproval[]
}

model DepositApproval {
  id        String   @id @default(cuid())
  studentId String
  amount    Float
  status    String   @default("PENDING")
  receipt   String?
  adminId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admin   Admin?  @relation(fields: [adminId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  studentId String
  action    String
  details   String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([studentId, action])
}

model Bazaar {
  id        String   @id @default(cuid())
  date      DateTime
  name      String
  details   String?
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     BazaarItem[]
}

model BazaarItem {
  id        String   @id @default(cuid())
  bazaarId  String
  name      String
  quantity  Float
  unit      String   // e.g., kg, liter, pcs
  price     Float
  createdAt DateTime @default(now())

  bazaar    Bazaar   @relation(fields: [bazaarId], references: [id], onDelete: Cascade)
}

model MealFeedback {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  text      String
  
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]
}

model PollVote {
  id           String     @id @default(cuid())
  pollId       String
  optionId     String
  studentId    String
  createdAt    DateTime   @default(now())

  poll         Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option       PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([pollId, studentId])
}

model BkashLedger {
  id           String   @id @default(cuid())
  trxId        String   @unique
  amount       Float
  senderNumber String?
  status       String   @default("UNCLAIMED") // UNCLAIMED, CLAIMED
  claimedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  claimedBy    Student? @relation("ClaimedBkash", fields: [claimedById], references: [id])
}

model DiningPeriod {
  id              String    @id @default(cuid())
  title           String    @unique
  startDate       DateTime
  endDate         DateTime
  depositDeadline DateTime? // The last date to deposit the minimum amount
  minimumDeposit  Float     @default(3000) // The required deposit amount by the deadline
  minimumBalance  Float     @default(200) // If balance drops below this ANY time, meal is OFF
  isActive        Boolean   @default(false)
  isSettled       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RefundRequest {
  id          String        @id @default(cuid())
  studentId   String
  amount      Float
  method      RefundMethod
  accountNo   String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model MealCheckIn {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime @db.Date // The logical date of the meal
  mealType  String   // "LUNCH" or "DINNER"
  status    String   // "AUTHORIZED", "DENIED"
  reason    String?  // E.g., "Insufficient Balance", "Already Scanned", "Meal Off"
  createdAt DateTime @default(now()) // Exact timestamp of scan

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  // Prevent scanning twice for the same meal
  @@index([date, mealType])
}
